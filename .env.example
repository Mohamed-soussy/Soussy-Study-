# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://yebriuvvtzawgqvbifbd.supabase.co
# The "anon" / "publishable" key. It is designed to be public (it ships to the browser);
# row-level security protects the data. NEVER put the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key for the AI tutor, file tagging and reading images (server only; never NEXT_PUBLIC).
# Without it, everything else still works and AI screens say the AI isn't connected.
ANTHROPIC_API_KEY=
