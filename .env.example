# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://yebriuvvtzawgqvbifbd.supabase.co
# The "anon" / "publishable" key. It is designed to be public (it ships to the browser);
# row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OPTIONAL, server only, NEVER NEXT_PUBLIC: lets the server save whiteboard lessons to the
# shared cache (whiteboard_lessons). Without it, lessons are cached per server and per browser.
SUPABASE_SERVICE_ROLE_KEY=

# AI engines (server only). Each feature says plainly when its engine has no key.
# Gemini: public content only (whiteboard lessons) + opt-in focus snapshots.
GEMINI_API_KEY=
# Groq: everything personal (chat, file tagging, reading photos, check-ins).
GROQ_API_KEY=
# Hugging Face: open-source models (embeddings). Needs Inference Provider credits.
HUGGINGFACE_ACCESS_TOKEN=

# Microsoft Teams / Outlook / OneDrive (Phase 5, "Connect Microsoft", section 10 Level 2).
# Register an app in Microsoft Entra ID → App registrations → New registration:
#   Supported account types: "Accounts in any organizational directory" (multitenant)
#   Redirect URI (Web): https://<your-site>/api/microsoft/callback (and http://localhost:3000/api/microsoft/callback)
#   API permissions (Microsoft Graph, delegated): User.Read, Calendars.Read, Files.Read,
#     EduAssignments.ReadBasic, offline_access, openid, profile, email
#   Certificates & secrets → New client secret.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Optional: "organizations" (default) or one school's tenant id.
MS_TENANT_ID=
# Optional: 32 random bytes, base64 (openssl rand -base64 32). Encrypts Microsoft sign-in
# tokens. If empty, a key is derived from SUPABASE_SERVICE_ROLE_KEY.
TOKEN_ENCRYPTION_KEY=
