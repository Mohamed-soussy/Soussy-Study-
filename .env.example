# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://yebriuvvtzawgqvbifbd.supabase.co
# The "anon" / "publishable" key. It is designed to be public (it ships to the browser);
# row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OPTIONAL, server only, NEVER NEXT_PUBLIC: lets the server save whiteboard lessons to the
# shared cache (whiteboard_lessons). Without it, lessons are cached per server and per browser.
SUPABASE_SERVICE_ROLE_KEY=

# AI engines (server only). Each feature says plainly when its engine has no key.
# Gemini: public content only (whiteboard lessons) + opt-in focus snapshots.
GEMINI_API_KEY=
# Groq: everything personal (chat, file tagging, reading photos, check-ins).
GROQ_API_KEY=
# Hugging Face: open-source models (embeddings). Needs Inference Provider credits.
HUGGINGFACE_ACCESS_TOKEN=
